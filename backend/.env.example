# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Supabase PostgreSQL - use values from Supabase Project Settings > Database
# DATABASE_URL: pooled connection (runtime)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: direct/session connection (Prisma migrations)
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

# Cookie/session settings
SESSION_COOKIE_NAME=ihost_session
SESSION_DAYS=7
# Set only when frontend and API share a parent domain
# COOKIE_DOMAIN=.example.com

# Never expose the service role key to Next.js or the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (optional but required for automatic admin notifications)
#WHATSAPP_ACCESS_TOKEN=
#WHATSAPP_PHONE_NUMBER_ID=
#WHATSAPP_GRAPH_VERSION=v23.0
