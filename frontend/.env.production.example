# Public URL of the API, without /api/v1
NEXT_PUBLIC_API_ORIGIN=https://api.example.com

# Optional: public origin used for uploaded images when the API returns relative paths.
# Prefer a CDN / Supabase public storage URL in production.
NEXT_PUBLIC_ASSET_ORIGIN=https://cdn.example.com

# Public site URL used by metadata/SEO helpers.
NEXT_PUBLIC_SITE_URL=https://www.example.com
