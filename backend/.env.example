NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# --- Stockage des images : Supabase Storage (OBLIGATOIRE) ---
# Supabase > Project Settings > API : "Project URL" et clé "service_role" (SECRÈTE).
# Ne jamais mettre la clé service_role dans le frontend / Vercel / Git.
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
SESSION_COOKIE_NAME=ihost_session
SESSION_DAYS=7
DEEPL_API_KEY=
# Pooler Supabase : limiter et temporiser les connexions évite les lenteurs
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- E-mails (réinitialisation du mot de passe) : choisir UN fournisseur ---
# APP_BASE_URL doit être l'URL publique du FRONTEND (les liens des e-mails pointent vers elle).
# MAIL_FROM : adresse d'expédition vérifiée chez le fournisseur.
MAIL_FROM=IHOST <no-reply@votre-domaine.com>
BREVO_API_KEY=
RESEND_API_KEY=

# --- SMTP classique (alternative à Brevo/Resend) — ex. Gmail ---
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<adresse>, SMTP_PASS=<mot de passe d'APPLICATION (16 lettres)>
# ⚠ Render bloque les ports SMTP sur l'offre gratuite : en production gratuite, utilisez BREVO_API_KEY (HTTPS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Notification WhatsApp envoyée par le SERVEUR (facultatif, désactivée par défaut) ---
# Le client envoie déjà son message en un clic : n'activer que pour recevoir une notification en plus.
WHATSAPP_SERVER_NOTIFY=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
