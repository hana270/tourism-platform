# Public URL of the API, without /api/v1 (ex: l'URL Render du backend)
NEXT_PUBLIC_API_ORIGIN=https://api.example.com

# NE PAS DÉFINIR NEXT_PUBLIC_ASSET_ORIGIN : les images sont maintenant des URLs
# Supabase complètes (https://xxxx.supabase.co/storage/v1/object/public/media/...)
# stockées en base, le frontend les affiche telles quelles.

# Public site URL used by metadata/SEO helpers.
NEXT_PUBLIC_SITE_URL=https://www.example.com
