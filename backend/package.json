{
  "name": "ihost-backend",
  "version": "2.0.0",
  "private": true,
  "description": "IHOST REST API - Next.js admin backend with Prisma and Supabase PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only --exit-child src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "echo \"Add Vitest/Supertest integration tests before production\""
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@google-cloud/translate": "^10.1.0",
    "@prisma/client": "5.19.1",
    "bcryptjs": "2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "sharp": "0.33.5",
    "slugify": "1.6.6",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "20.14.15",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "prettier": "3.3.3",
    "prisma": "5.19.1",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "^1.8.11",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.19.1",
    "typescript": "^5.9.3"
  }
}
